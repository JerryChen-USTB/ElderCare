# ElderCare 开发环境配置
# 注意：此文件包含敏感信息，已被.gitignore忽略，不会提交到Git

spring:
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.jdbc.Driver
    url: jdbc:mysql://localhost:3306/eldercare_project?useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: 1234
  data:
    redis:
      host: localhost
      port: 6379
  # 配置DevTools排除语音记录目录，避免热更新重启
  devtools:
    restart:
#      exclude: Speech_to_Text_Records/**
      enabled: false

langchain4j:
  open-ai:
    chat-model:
      # base-url: https://api.siliconflow.cn/v1
      # api-key: your-siliconflow-api-key
      # model-name: deepseek-ai/DeepSeek-V3
      base-url: https://router.huggingface.co/v1
      api-key: your-huggingface-api-key
      model-name: openai/gpt-oss-120b:cerebras
      log-requests: true
      log-responses: true
    streaming-chat-model:
      # base-url: https://api.siliconflow.cn/v1
      # api-key: your-siliconflow-api-key
      # model-name: deepseek-ai/DeepSeek-V3
      # base-url: https://api.siliconflow.cn/v1
      # api-key: your-siliconflow-api-key
      # model-name: Qwen/Qwen3-Coder-480B-A35B-Instruct
      base-url: https://router.huggingface.co/v1
      api-key: your-huggingface-api-key
      model-name: openai/gpt-oss-120b:nebius
      # base-url: https://api-inference.modelscope.cn/v1/
      # api-key: your-modelscope-api-key
      # model-name: deepseek-ai/DeepSeek-V3.1
      # base-url: https://api.siliconflow.cn/v1
      # api-key: your-siliconflow-api-key
      # model-name: deepseek-ai/DeepSeek-R1
      log-requests: true
      log-responses: true
    embedding-model:
      base-url: https://api.siliconflow.cn/v1
      api-key: your-siliconflow-api-key
      model-name: Qwen/Qwen3-Embedding-8B
      log-requests: true
      log-responses: true

logging:
  level:
    dev.langchain4j: debug
    root: info
  
# 开发环境下的额外配置
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

app:
  upload:
    avatar-path: D:/Desktop/avatarstest
    static-mapping: /upload/**
  
  # 用户数据存储配置
  user-data:
    root-path: D:/OneDrive/SRTP/project/ElderCare/data
    users-dir: users

# 腾讯云TRTC配置
tencent:
  cloud:
    # 腾讯云API密钥配置
    secret-id: ${TENCENTCLOUD_SECRET_ID:your-tencentcloud-secret-id}
    secret-key: ${TENCENTCLOUD_SECRET_KEY:your-tencentcloud-secret-key}
    
    # TRTC应用配置
    trtc:
      sdk-app-id: ${TRTC_SDK_APP_ID:0}  # 请填写您的SdkAppId
      secret-key: ${TRTC_SECRET_KEY:your-trtc-secret-key}  # 请填写您的TRTC SecretKey

# 百度智能云灵医开放平台配置
baidu:
  lingyi:
    ak: ${BAIDU_LINGYI_AK:your-baidu-lingyi-ak}
    sk: ${BAIDU_LINGYI_SK:your-baidu-lingyi-sk}
    host: ${BAIDU_LINGYI_HOST:https://01bot.baidu.com}
    model: ${BAIDU_LINGYI_MODEL:third-common-v2-healthQA}